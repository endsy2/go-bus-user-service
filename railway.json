{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd user-service && ./gradlew build -x test"
  },
  "deploy": {
    "startCommand": "java -Dserver.port=$PORT -Xmx512m -Xms256m -jar user-service/build/libs/user-service-0.0.1-SNAPSHOT.jar",
    "healthcheckPath": "/actuator/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}