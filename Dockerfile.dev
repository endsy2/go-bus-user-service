# Development Dockerfile for User Service
# Optimized for fast rebuilds and development

FROM gradle:8.5-jdk17
WORKDIR /app

# Copy gradle wrapper and build files
COPY gradlew gradlew
COPY gradle gradle
COPY build.gradle build.gradle
COPY settings.gradle settings.gradle

# Copy service files
COPY go-bus-user-service/build.gradle go-bus-user-service/build.gradle
COPY go-bus-user-service/src go-bus-user-service/src

# Make gradlew executable
RUN chmod +x gradlew

# Download dependencies (cached layer)
RUN ./gradlew :go-bus-user-service:dependencies --no-daemon || true

# Expose port
EXPOSE 8081

# Run with hot reload
CMD ["./gradlew", ":go-bus-user-service:bootRun", "--no-daemon"]
